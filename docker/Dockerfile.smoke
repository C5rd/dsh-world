# 一体化冒烟：把 DSH 宿主也装进来，用假 OneBot 喂一条，看整条管道通不通。
#
#   docker build -f docker/Dockerfile.smoke --build-arg BASE_IMAGE=node:22-slim -t dsh-world-smoke .
#   docker run --rm dsh-world-smoke
#
# 它回答的是「陌生人照着 INSTALL 装得上、起得来吗」。**不回答「她会不会回话」** —— 那要模型凭据，
# 所以这里只断言：装进去、宿主起来了、端点有、事件收得到、阳台开得出来。
ARG BASE_IMAGE=node:22-slim
FROM ${BASE_IMAGE}

# dsh plugin 是转发给 pnpm 的
RUN corepack enable && corepack prepare pnpm@latest --activate
RUN npm i -g @deepseek-ai/dsh@0.2.1-rc.2

ENV DSH_HOME=/dsh-home
WORKDIR /plugin

# 依赖层单独缓存
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build && npm pack

# 装进 web 那个 profile（`dsh web` 不带 --profile 时就是它；换个新 profile 还得先给它一个 app）
RUN dsh plugin --profile web add /plugin/dsh-world-0.6.0.tgz

COPY docker/smoke.mjs docker/container.yml /plugin/docker/

CMD ["node", "/plugin/docker/smoke.mjs"]