# 在 Linux 容器里跑一遍：类型检查、构建、全部测试。
#
# 这条镜像不需要 DSH 宿主 —— 测试里的宿主、会话、模型都是假的（tests/hostFixture）。
# 它回答的是：「去掉 Windows 之后，这份代码还算不算好的。」
#
#   docker build -f docker/Dockerfile.test -t dsh-world-test .
#   docker run --rm dsh-world-test
#
# 拉不动 docker hub 的地方（比如国内），换一个基础镜像源就行，不用改这个文件：
#   docker build -f docker/Dockerfile.test --build-arg BASE_IMAGE=docker.m.daocloud.io/library/node:22-slim -t dsh-world-test .
ARG BASE_IMAGE=node:22-slim
FROM ${BASE_IMAGE}

# 构建期的缓存分界线：依赖没变就不重装
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

RUN npm run typecheck && npm run build

# 跑可移植的那部分。三份不在这里跑，原因见 docker/README.md：它们 import 到 src/... -> @snowluma/sdk，
# 而那个包在 Linux 上自己就装不起来（dist/index.js 里 import 了一个大小写对不上的文件）。
# 只对 Windows 成立的那几条断言，已经在测试文件里用 process.platform !== 'win32' 标掉了。
RUN node --experimental-strip-types --disable-warning=ExperimentalWarning --test \
      $(ls tests/*.test.ts | grep -vE 'qqNative\.test\.ts|qqSnowluma\.test\.ts|plugin\.test\.ts')